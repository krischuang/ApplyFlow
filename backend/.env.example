ANTHROPIC_API_KEY=sk-ant-your-key-here
DATABASE_URL=sqlite:///./applyflow.db
RESUME_STORAGE_PATH=./resumes
SEEK_MAX_JOBS_PER_RUN=20

# Set to false to watch the browser while it scrapes/applies (useful for
# debugging a broken selector, or recording a demo). Leave true otherwise.
PLAYWRIGHT_HEADLESS=true

# For production with PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/applyflow
